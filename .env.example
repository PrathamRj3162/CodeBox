# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Neon Postgres connection string
DATABASE_URL=

# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# AI hints (optional). Without these two the "AI Hint" button shows a friendly error.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Check https://ai.google.dev/gemini-api/docs/models for the current model name
AI_MODEL=gemini-3.8-flash
# Hints per user per day (default 10)
AI_DAILY_HINT_LIMIT=10
